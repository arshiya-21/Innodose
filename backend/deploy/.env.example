# Copy this file to ".env" (same folder) and fill in the values. Restart the service after any change.
PORT=5173

# Always 'mysql' for a real installation.
ADMIN_DRIVER=mysql
DB_DRIVER=mock

# MySQL 8 server holding the Inodose database (create an empty database + user first, see the guide).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=inodose
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=inodose
# Database holding the dosing records (innodose_casting_details_v2). Usually the same one.
MYSQL_DATA_DATABASE=inodose

# Only if the PLC write tool needs a specific interpreter, e.g. python3 on Linux or C:\Python312\python.exe on Windows.
#PYTHON_BIN=python3

# Optional: how often alert e-mails are checked (ms) and the address put on the desktop icon (Windows).
#ALERT_MAIL_POLL_MS=10000
#APP_PUBLIC_URL=http://192.168.1.50:4000/
#DESKTOP_SHORTCUT=off
